# Python
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
.Python
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editable install
*.egg-link
src/*.egg-info/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checkers
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Docs — protocols and concise audit conclusions are versioned.
docs/*
!docs/known_uncertainties.md
!docs/datasets/
!docs/datasets/**
!docs/reproductions/
!docs/reproductions/**

# Data — NEVER commit raw or processed battery data
data/raw/
data/interim/
data/processed/
# Manifests are small CSV/YAML index files; commit them if desired
# data/manifests/

# OS
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
ehthumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cache
.cache/
*.pkl
*.npy

# Colab-specific
/content/

# Secrets / credentials
*.env
.env
secrets.yaml
credentials.json

# External repositories workspace
# Sub-directories are ignored; only root tracking files are committed.
external_repos/references/*
external_repos/reproductions/*
external_repos/archived/*
!external_repos/README.md
!external_repos/.gitkeep
!external_repos/repo_registry.example.yaml
# The local registry file is never committed (may contain private URLs)
external_repos/repo_registry.local.yaml
# Prevent nested Git repositories from leaking into the index
external_repos/**/.git
notebooks/inspect_three_adapters.ipynb
notebooks/review_vidal_charge_pairing.ipynb
